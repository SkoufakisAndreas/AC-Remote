--cpu=Cortex-M4.fp.sp
"ac_remote\startup_stm32f411xe.o"
"ac_remote\main.o"
"ac_remote\stm32f4xx_it.o"
"ac_remote\stm32f4xx_hal_msp.o"
"ac_remote\stm32f4xx_hal_tim.o"
"ac_remote\stm32f4xx_hal_tim_ex.o"
"ac_remote\stm32f4xx_hal_rcc.o"
"ac_remote\stm32f4xx_hal_rcc_ex.o"
"ac_remote\stm32f4xx_hal_flash.o"
"ac_remote\stm32f4xx_hal_flash_ex.o"
"ac_remote\stm32f4xx_hal_flash_ramfunc.o"
"ac_remote\stm32f4xx_hal_gpio.o"
"ac_remote\stm32f4xx_hal_dma_ex.o"
"ac_remote\stm32f4xx_hal_dma.o"
"ac_remote\stm32f4xx_hal_pwr.o"
"ac_remote\stm32f4xx_hal_pwr_ex.o"
"ac_remote\stm32f4xx_hal_cortex.o"
"ac_remote\stm32f4xx_hal.o"
"ac_remote\stm32f4xx_hal_exti.o"
"ac_remote\stm32f4xx_hal_uart.o"
"ac_remote\system_stm32f4xx.o"
--strict --scatter "ac_remote\ac_remote.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "ac_remote.map" -o ac_remote\ac_remote.axf